<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://standard.tat.or.th/occupancyRateAverage"
            targetNamespace="http://standard.tat.or.th/occupancyRateAverage"
            elementFormDefault="qualified"
            attributeFormDefault="unqualified">
    <xsd:element name="occupancyRateAverage">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="reportingYear" type="xsd:int" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="tatRegion" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="province" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="reportMonth" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="areaType" type="AreaType" minOccurs="0" maxOccurs="1"/>
                <xsd:element name="accommodationData" type="AccommodationDataType" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="occupancyRateItem" type="OccupancyRateItemType" minOccurs="1" maxOccurs="1"/>
                <xsd:element name="reportType" type="ReportType" minOccurs="0" maxOccurs="1"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:complexType name="AreaType">
        <xsd:sequence>
            <xsd:element name="urbanArea" type="xsd:string" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="ruralArea" type="xsd:string" minOccurs="0" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="AccommodationDataType">
        <xsd:sequence>
            <xsd:element name="accommodationCount" type="xsd:int" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="accommodationChangePercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="roomCount" type="xsd:int" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="roomChangePercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="OccupancyRateItemType">
        <xsd:sequence>
            <xsd:element name="monthlyTotalPercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="monthlyTotalChangePercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="averageOccupancyRatePercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="averageOccupancyRateChangePercent" type="xsd:decimal" minOccurs="0" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ReportType">
        <xsd:sequence>
            <xsd:element name="monthlyReport" type="xsd:string" minOccurs="0" maxOccurs="1"/>
            <xsd:element name="monthlyCumulativeReport" type="xsd:string" minOccurs="0" maxOccurs="1"/>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>
